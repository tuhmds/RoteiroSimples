importe "padrao/cadastro_retomada.rts" como disco
importe "padrao/cadastro_variavel.rts" como cad
inicio {
    seja leitura = disco.carregar()
    se leitura.valido == falso {
        escreva(leitura.codigo_erro)
        encerre(3)
    }
    // A entrada pode demorar: a geracao impede sobrescrever outro gravador.
    escreva(leitura.geracao)
    seja numero = 0
    leia(numero)
    se numero < 0 {
        encerre(2)
    }
    se numero > 255 {
        encerre(2)
    }
    seja cadastro = mova(leitura.valor)
    seja novo: cad.Registro
    novo.codigo = 7
    copie(novo.titulo, "Ação 🌱")
    para indice de 0 ate 5999 {
        adicione_byte(novo.conteudo, (numero + indice) % 256)
    }
    se cad.localizar(empreste(cadastro), 7) < 0 {
        seja adicao = cad.adicionar(mova(cadastro), mova(novo))
        mova(cadastro, adicao.valor)
    } senao {
        seja alteracao = cad.alterar(mova(cadastro), mova(novo))
        mova(cadastro, alteracao.valor)
    }
    seja gravacao = disco.salvar(empreste(cadastro), leitura.geracao)
    escreva(gravacao.codigo_erro)
    escreva(gravacao.geracao)
    se gravacao.valido == falso {
        encerre(3)
    }
}
