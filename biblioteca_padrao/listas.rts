// Biblioteca Padrão RS 0.29 — listas de cinco inteiros.
// Os parâmetros são copiados por valor. Não existe alias com o chamador.

publico funcao buscar_cinco(valores: lista[5], procurado: inteiro) -> inteiro {
    seja i = 0
    enquanto i < 5 {
        se valores[i] == procurado {
            retorne i
        }
        i = i + 1
    }
    retorne -1
}

publico funcao contar_cinco(valores: lista[5], procurado: inteiro) -> inteiro {
    seja quantidade = 0
    seja i = 0
    enquanto i < 5 {
        se valores[i] == procurado {
            quantidade = quantidade + 1
        }
        i = i + 1
    }
    retorne quantidade
}

publico funcao contem_cinco(valores: lista[5], procurado: inteiro) -> logico {
    retorne buscar_cinco(valores, procurado) != -1
}

publico funcao crescente_cinco(valores: lista[5]) -> logico {
    seja i = 1
    enquanto i < 5 {
        se valores[i] < valores[i - 1] {
            retorne falso
        }
        i = i + 1
    }
    retorne verdadeiro
}

publico funcao inverter_cinco(valores: lista[5]) -> lista[5] {
    seja invertidos: lista[5]
    seja i = 0
    enquanto i < 5 {
        invertidos[4 - i] = valores[i]
        i = i + 1
    }
    retorne invertidos
}

publico funcao ordenar_cinco(valores: lista[5]) -> lista[5] {
    seja ordenados: lista[5] = valores
    seja i = 0
    enquanto i < 5 {
        seja j = i + 1
        enquanto j < 5 {
            se ordenados[j] < ordenados[i] {
                seja temporario = ordenados[i]
                ordenados[i] = ordenados[j]
                ordenados[j] = temporario
            }
            j = j + 1
        }
        i = i + 1
    }
    retorne ordenados
}

publico funcao substituir_cinco(valores: lista[5], antigo: inteiro, novo: inteiro) -> lista[5] {
    seja resultado: lista[5] = valores
    seja i = 0
    enquanto i < 5 {
        se resultado[i] == antigo {
            resultado[i] = novo
        }
        i = i + 1
    }
    retorne resultado
}

// RS 0.42A: consultas de tamanho arbitrario por emprestimo de leitura.
// O conteudo da colecao nao e copiado para chamar estas funcoes.
publico funcao buscar(valores: emprestimo[lista[inteiro]], procurado: inteiro) -> inteiro {
    seja quantidade = tamanho(valores)
    seja indice = 0
    enquanto indice < quantidade {
        se valores[indice] == procurado {
            retorne indice
        }
        indice = indice + 1
    }
    retorne -1
}

publico funcao contar(valores: emprestimo[lista[inteiro]], procurado: inteiro) -> inteiro {
    seja quantidade = tamanho(valores)
    seja encontrados = 0
    seja indice = 0
    enquanto indice < quantidade {
        se valores[indice] == procurado {
            encontrados = encontrados + 1
        }
        indice = indice + 1
    }
    retorne encontrados
}

publico funcao contem(valores: emprestimo[lista[inteiro]], procurado: inteiro) -> logico {
    retorne buscar(valores, procurado) >= 0
}

publico funcao crescente(valores: emprestimo[lista[inteiro]]) -> logico {
    seja quantidade = tamanho(valores)
    seja indice = 1
    enquanto indice < quantidade {
        se valores[indice] < valores[indice - 1] {
            retorne falso
        }
        indice = indice + 1
    }
    retorne verdadeiro
}

// A selecao cria outra colecao, cuja propriedade pertence ao chamador.
publico funcao selecionar_intervalo(valores: emprestimo[lista[inteiro]], minimo: inteiro, maximo: inteiro) -> lista[inteiro] {
    seja selecionados: lista[inteiro]
    seja quantidade = tamanho(valores)
    seja indice = 0
    enquanto indice < quantidade {
        seja valor = valores[indice]
        se valor >= minimo {
            se valor <= maximo {
                adicione(selecionados, valor)
            }
        }
        indice = indice + 1
    }
    retorne mova(selecionados)
}
