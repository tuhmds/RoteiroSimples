// Plano intermediario de instrucoes para emissao ELF em RS.
// Uma representacao tipada ordenada (sem codigo de maquina) para o bloco inicio.
// Categoria: 1 declaracao, 2 atribuicao, 3 se, 4 enquanto,
// 5 fechamento de controle, 6 fechamento de inicio, 8 transicao senao,
// 9 pare, 10 continue. Erro 16: desvio de laco invalido.
importe "lexico.rts" como lexico
importe "emissao_fluxo_elf.rts" como fluxo
importe "esquemas_registros_elf.rts" como esquemas

publico tipo Instrucao {
    categoria: inteiro
    unidade_inicio: inteiro
    unidade_nome: inteiro
    valor_inicio: inteiro
    valor_fim: inteiro
    profundidade: inteiro
    tipo_local: inteiro // 1 inteiro, 2 bytes local, 3 bytes dinamico, 5 lista local
    indice_inicio: inteiro
    indice_fim: inteiro
    tipo_unidade: inteiro
    campo_unidade: inteiro
    campo_fim: inteiro // apos ultimo identificador do caminho aninhado
}

publico tipo Plano {
    instrucoes: lista[Instrucao]
    quantidade_locais: inteiro
    codigo_erro: inteiro
    unidade_erro: inteiro
}

// Analisar toda a area principal, sem ignorar comandos nao suportados.
// Limites para o primeiro backend unificado: 128 locais, 32 niveis e
// ate 12000 tokens. Funcoes anteriores ao inicio sao tratadas fora daqui.
publico funcao analisar(fonte: emprestimo[bytes], unidades: emprestimo[lista[lexico.UnidadeLexica]], unidade_inicio: inteiro) -> Plano {
    seja plano: Plano
    seja registros = esquemas.analisar(fonte, unidades)
    se registros.codigo_erro != 0 {
        plano.codigo_erro = registros.codigo_erro
        plano.unidade_erro = registros.unidade_erro
        retorne mova(plano)
    }
    seja total = tamanho(unidades)
    se total > 12000 ou unidade_inicio + 2 >= total {
        plano.codigo_erro = 8
        retorne mova(plano)
    }
    seja texto_inicio: texto = "inicio"
    seja texto_seja: texto = "seja"
    seja texto_inteiro: texto = "inteiro"
    seja texto_bytes: texto = "bytes"
    seja texto_lista: texto = "lista"
    seja texto_adicione: texto = "adicione"
    seja texto_criar: texto = "criar_bytes"
    seja texto_liberar: texto = "liberar_bytes"
    seja texto_se: texto = "se"
    seja texto_enquanto: texto = "enquanto"
    seja texto_senao: texto = "senao"
    seja texto_pare: texto = "pare"
    seja texto_continue: texto = "continue"
    seja principal: lexico.UnidadeLexica = unidades[unidade_inicio]
    seja abertura: lexico.UnidadeLexica = unidades[unidade_inicio + 1]
    se nao fluxo.igual(fonte, principal, empreste(texto_inicio)) ou nao fluxo.simbolo(fonte, abertura, 123) {
        plano.codigo_erro = 2
        plano.unidade_erro = unidade_inicio
        retorne mova(plano)
    }
    seja profundidade = 0
    seja pilha_controles: lista[inteiro]
    seja quantidade_lacos = 0
    seja desvio_bloqueante = -1
    seja i = unidade_inicio + 2
    enquanto i < total {
        plano.unidade_erro = i
        seja token: lexico.UnidadeLexica = unidades[i]
        seja instrucao: Instrucao
        instrucao.unidade_inicio = i
        instrucao.unidade_nome = -1
        instrucao.valor_inicio = -1
        instrucao.valor_fim = -1
        instrucao.indice_inicio = -1
        instrucao.indice_fim = -1
        instrucao.tipo_unidade = -1
        instrucao.campo_unidade = -1
        instrucao.campo_fim = -1
        instrucao.profundidade = profundidade
        // Depois de pare/continue, so o fechamento do bloco alcancado
        // por esse desvio permanece analisavel neste nivel.
        se desvio_bloqueante >= 0 {
            se fluxo.simbolo(fonte, token, 125) e profundidade == desvio_bloqueante {
                desvio_bloqueante = -1
            } senao {
                plano.codigo_erro = 10
                retorne mova(plano)
            }
        }
        se fluxo.simbolo(fonte, token, 125) {
            se profundidade == 0 {
                se i != total - 1 {
                    plano.codigo_erro = 2
                    retorne mova(plano)
                }
                instrucao.categoria = 6
                adicione(plano.instrucoes, instrucao)
                i = i + 1
                pare
            }
            // "senao" reutiliza o nivel do "se": a transicao fecha
            // o bloco verdadeiro e abre o falso sem encerrar o controle.
            se i + 1 < total {
                seja palavra_senao: lexico.UnidadeLexica = unidades[i + 1]
                se fluxo.igual(fonte, palavra_senao, empreste(texto_senao)) {
                    plano.unidade_erro = i + 1
                    se tamanho(pilha_controles) == 0 ou pilha_controles[tamanho(pilha_controles) - 1] != 3 ou i + 2 >= total {
                        plano.codigo_erro = 7
                        retorne mova(plano)
                    }
                    seja abre_senao: lexico.UnidadeLexica = unidades[i + 2]
                    se nao fluxo.simbolo(fonte, abre_senao, 123) {
                        plano.codigo_erro = 7
                        retorne mova(plano)
                    }
                    instrucao.categoria = 8
                    adicione(plano.instrucoes, instrucao)
                    pilha_controles[tamanho(pilha_controles) - 1] = 8
                    i = i + 3
                    continue
                }
            }
            instrucao.categoria = 5
            adicione(plano.instrucoes, instrucao)
            se pilha_controles[tamanho(pilha_controles) - 1] == 4 {
                quantidade_lacos = quantidade_lacos - 1
            }
            remova_ultimo(pilha_controles)
            profundidade = profundidade - 1
            i = i + 1
            continue
        }
        seja eh_se = fluxo.igual(fonte, token, empreste(texto_se))
        seja eh_enquanto = fluxo.igual(fonte, token, empreste(texto_enquanto))
        se eh_se ou eh_enquanto {
            se profundidade >= 32 {
                plano.codigo_erro = 8
                retorne mova(plano)
            }
            seja cursor = i + 1
            seja nivel_parenteses = 0
            enquanto cursor < total {
                seja atual: lexico.UnidadeLexica = unidades[cursor]
                se fluxo.simbolo(fonte, atual, 40) {
                    nivel_parenteses = nivel_parenteses + 1
                }
                se fluxo.simbolo(fonte, atual, 41) {
                    nivel_parenteses = nivel_parenteses - 1
                }
                se nivel_parenteses < 0 {
                    pare
                }
                se nivel_parenteses == 0 e fluxo.simbolo(fonte, atual, 123) {
                    pare
                }
                cursor = cursor + 1
            }
            se cursor >= total ou cursor == i + 1 ou nivel_parenteses != 0 {
                plano.codigo_erro = 7
                retorne mova(plano)
            }
            seja inicio_bloco: lexico.UnidadeLexica = unidades[cursor]
            se nao fluxo.simbolo(fonte, inicio_bloco, 123) {
                plano.codigo_erro = 7
                retorne mova(plano)
            }
            instrucao.categoria = 3
            se eh_enquanto {
                instrucao.categoria = 4
            }
            instrucao.valor_inicio = i + 1
            instrucao.valor_fim = cursor
            adicione(plano.instrucoes, instrucao)
            adicione(pilha_controles, instrucao.categoria)
            se instrucao.categoria == 4 {
                quantidade_lacos = quantidade_lacos + 1
            }
            profundidade = profundidade + 1
            i = cursor + 1
            continue
        }
        seja comando_pare = fluxo.igual(fonte, token, empreste(texto_pare))
        seja comando_continue = fluxo.igual(fonte, token, empreste(texto_continue))
        se comando_pare ou comando_continue {
            se quantidade_lacos == 0 {
                plano.codigo_erro = 16
                retorne mova(plano)
            }
            instrucao.categoria = 9
            se comando_continue {
                instrucao.categoria = 10
            }
            adicione(plano.instrucoes, instrucao)
            desvio_bloqueante = profundidade
            i = i + 1
            se i < total {
                seja seguinte: lexico.UnidadeLexica = unidades[i]
                se fluxo.simbolo(fonte, seguinte, 59) {
                    i = i + 1
                } senao {
                    se seguinte.linha == token.linha e nao fluxo.simbolo(fonte, seguinte, 125) {
                        plano.codigo_erro = 16
                        plano.unidade_erro = i
                        retorne mova(plano)
                    }
                }
            }
            continue
        }
        se fluxo.simbolo(fonte, token, 123) {
            plano.codigo_erro = 3
            retorne mova(plano)
        }
        // adicione(lista, expressao): o tamanho e atualizado no emissor.
        se fluxo.igual(fonte, token, empreste(texto_adicione)) {
            se i + 5 >= total {
                plano.codigo_erro = 3
                retorne mova(plano)
            }
            seja abertura_adicionar: lexico.UnidadeLexica = unidades[i + 1]
            seja nome_adicionar: lexico.UnidadeLexica = unidades[i + 2]
            seja virgula_adicionar: lexico.UnidadeLexica = unidades[i + 3]
            se nao fluxo.simbolo(fonte, abertura_adicionar, 40) ou nome_adicionar.classe != 1 ou nao fluxo.simbolo(fonte, virgula_adicionar, 44) {
                plano.codigo_erro = 3
                retorne mova(plano)
            }
            seja cursor_adicionar = i + 4
            seja nivel_adicionar = 0
            enquanto cursor_adicionar < total {
                seja atual_adicionar: lexico.UnidadeLexica = unidades[cursor_adicionar]
                se fluxo.simbolo(fonte, atual_adicionar, 40) {
                    nivel_adicionar = nivel_adicionar + 1
                }
                se fluxo.simbolo(fonte, atual_adicionar, 41) {
                    se nivel_adicionar == 0 {
                        pare
                    }
                    nivel_adicionar = nivel_adicionar - 1
                }
                se fluxo.simbolo(fonte, atual_adicionar, 125) {
                    pare
                }
                cursor_adicionar = cursor_adicionar + 1
            }
            se cursor_adicionar >= total ou cursor_adicionar == i + 4 {
                plano.codigo_erro = 3
                retorne mova(plano)
            }
            seja fecho_adicionar: lexico.UnidadeLexica = unidades[cursor_adicionar]
            se nao fluxo.simbolo(fonte, fecho_adicionar, 41) {
                plano.codigo_erro = 3
                retorne mova(plano)
            }
            instrucao.categoria = 13
            instrucao.unidade_nome = i + 2
            instrucao.valor_inicio = i + 4
            instrucao.valor_fim = cursor_adicionar
            adicione(plano.instrucoes, instrucao)
            i = cursor_adicionar + 1
            se i < total {
                seja separador_adicionar: lexico.UnidadeLexica = unidades[i]
                se fluxo.simbolo(fonte, separador_adicionar, 59) {
                    i = i + 1
                }
            }
            continue
        }
        // liberar_bytes(nome) e uma instrucao explicita de ciclo de vida.
        se fluxo.igual(fonte, token, empreste(texto_liberar)) {
            se i + 3 >= total {
                plano.codigo_erro = 3
                retorne mova(plano)
            }
            seja abre_liberar: lexico.UnidadeLexica = unidades[i + 1]
            seja nome_liberar: lexico.UnidadeLexica = unidades[i + 2]
            seja fecha_liberar: lexico.UnidadeLexica = unidades[i + 3]
            se nao fluxo.simbolo(fonte, abre_liberar, 40) ou nome_liberar.classe != 1 ou nao fluxo.simbolo(fonte, fecha_liberar, 41) {
                plano.codigo_erro = 3
                retorne mova(plano)
            }
            instrucao.categoria = 12
            instrucao.unidade_nome = i + 2
            adicione(plano.instrucoes, instrucao)
            i = i + 4
            se i < total {
                seja separador_liberar: lexico.UnidadeLexica = unidades[i]
                se fluxo.simbolo(fonte, separador_liberar, 59) {
                    i = i + 1
                }
            }
            continue
        }
        seja declaracao = fluxo.igual(fonte, token, empreste(texto_seja))
        seja posicao_nome = i
        se declaracao {
            // Declaracoes em se, senao e enquanto tambem recebem um slot
            // proprio; a visibilidade e controlada pelo emissor.
            posicao_nome = i + 1
            plano.quantidade_locais = plano.quantidade_locais + 1
            se plano.quantidade_locais > 128 {
                plano.codigo_erro = 8
                retorne mova(plano)
            }
        }
        se posicao_nome + 2 >= total {
            plano.codigo_erro = 3
            retorne mova(plano)
        }
        seja nome: lexico.UnidadeLexica = unidades[posicao_nome]
        se nome.classe != 1 {
            plano.codigo_erro = 3
            retorne mova(plano)
        }
        seja indice_igual = posicao_nome + 1
        // Uma atribuicao indexada e uma instrucao diferente da atribuicao
        // do buffer inteiro: dados[indice] = valor.
        seja indexado = falso
        se nao declaracao {
            // registro.campo = expressao, sem indexacao nem copia.
            seja abertura_campo: lexico.UnidadeLexica = unidades[indice_igual]
            se fluxo.simbolo(fonte, abertura_campo, 46) {
                se indice_igual + 2 >= total {
                    plano.codigo_erro = 3
                    retorne mova(plano)
                }
                seja nome_campo: lexico.UnidadeLexica = unidades[indice_igual + 1]
                se nome_campo.classe != 1 {
                    plano.codigo_erro = 3
                    retorne mova(plano)
                }
                instrucao.campo_unidade = indice_igual + 1
                indice_igual = indice_igual + 2
                enquanto indice_igual + 1 < total {
                    seja ponto_extra: lexico.UnidadeLexica = unidades[indice_igual]
                    se nao fluxo.simbolo(fonte, ponto_extra, 46) {
                        pare
                    }
                    seja parte_extra: lexico.UnidadeLexica = unidades[indice_igual + 1]
                    se parte_extra.classe != 1 {
                        plano.codigo_erro = 3
                        retorne mova(plano)
                    }
                    indice_igual = indice_igual + 2
                }
                instrucao.campo_fim = indice_igual
            }
            seja abertura_indice: lexico.UnidadeLexica = unidades[indice_igual]
            se fluxo.simbolo(fonte, abertura_indice, 91) {
                instrucao.indice_inicio = indice_igual + 1
                seja cursor_indice = instrucao.indice_inicio
                enquanto cursor_indice < total {
                    seja atual_indice: lexico.UnidadeLexica = unidades[cursor_indice]
                    se fluxo.simbolo(fonte, atual_indice, 93) {
                        pare
                    }
                    cursor_indice = cursor_indice + 1
                }
                se cursor_indice >= total ou cursor_indice == instrucao.indice_inicio {
                    plano.codigo_erro = 3
                    retorne mova(plano)
                }
                instrucao.indice_fim = cursor_indice
                indice_igual = cursor_indice + 1
                indexado = verdadeiro
                se indice_igual >= total {
                    plano.codigo_erro = 3
                    retorne mova(plano)
                }
                // lista_registros[indice].campo = expressao.
                seja talvez_ponto: lexico.UnidadeLexica = unidades[indice_igual]
                se fluxo.simbolo(fonte, talvez_ponto, 46) {
                    se indice_igual + 2 >= total {
                        plano.codigo_erro = 3
                        retorne mova(plano)
                    }
                    seja campo_indexado: lexico.UnidadeLexica = unidades[indice_igual + 1]
                    se campo_indexado.classe != 1 {
                        plano.codigo_erro = 3
                        retorne mova(plano)
                    }
                    instrucao.campo_unidade = indice_igual + 1
                    indice_igual = indice_igual + 2
                    enquanto indice_igual + 1 < total {
                        seja ponto_extra: lexico.UnidadeLexica = unidades[indice_igual]
                        se nao fluxo.simbolo(fonte, ponto_extra, 46) {
                            pare
                        }
                        seja parte_extra: lexico.UnidadeLexica = unidades[indice_igual + 1]
                        se parte_extra.classe != 1 {
                            plano.codigo_erro = 3
                            retorne mova(plano)
                        }
                        indice_igual = indice_igual + 2
                    }
                    instrucao.campo_fim = indice_igual
                }
            }
        }
        // Bytes locais usam 7 slots: comprimento, 32 bytes de dados e
        // 2 slots de descritor emprestavel. Dinamicos mantem 5 slots.
        // Outras declaracoes continuam usando apenas um slot.
        instrucao.tipo_local = 1
        seja separador_tipo: lexico.UnidadeLexica = unidades[indice_igual]
        se declaracao e fluxo.simbolo(fonte, separador_tipo, 58) {
            se indice_igual + 2 >= total {
                plano.codigo_erro = 3
                retorne mova(plano)
            }
            seja unidade_tipo: lexico.UnidadeLexica = unidades[indice_igual + 1]
            plano.unidade_erro = indice_igual + 1
            se fluxo.igual(fonte, unidade_tipo, empreste(texto_bytes)) {
                instrucao.tipo_local = 2
                plano.quantidade_locais = plano.quantidade_locais + 4
            } senao {
                se fluxo.igual(fonte, unidade_tipo, empreste(texto_lista)) {
                    // lista[inteiro]: qword de tamanho e oito inteiros.
                    se indice_igual + 5 >= total {
                        plano.codigo_erro = 2
                        retorne mova(plano)
                    }
                    seja abre_lista: lexico.UnidadeLexica = unidades[indice_igual + 2]
                    seja item_lista: lexico.UnidadeLexica = unidades[indice_igual + 3]
                    seja fecha_lista: lexico.UnidadeLexica = unidades[indice_igual + 4]
                    se nao fluxo.simbolo(fonte, abre_lista, 91) ou nao fluxo.simbolo(fonte, fecha_lista, 93) {
                        plano.codigo_erro = 2
                        retorne mova(plano)
                    }
                    se fluxo.igual(fonte, item_lista, empreste(texto_inteiro)) {
                        instrucao.tipo_local = 5
                    } senao {
                        seja tipo_elemento = esquemas.buscar_tipo(fonte, unidades, empreste(registros), item_lista)
                        se tipo_elemento < 0 {
                            plano.codigo_erro = 2
                            retorne mova(plano)
                        }
                        instrucao.tipo_local = 20 + tipo_elemento
                    }
                    plano.quantidade_locais = plano.quantidade_locais + 2
                    indice_igual = indice_igual + 3
                } senao {
                    se nao fluxo.igual(fonte, unidade_tipo, empreste(texto_inteiro)) {
                        seja indice_registro = esquemas.buscar_tipo(fonte, unidades, empreste(registros), unidade_tipo)
                        se indice_registro < 0 {
                            plano.codigo_erro = 2
                            retorne mova(plano)
                        }
                        seja layout: esquemas.TipoRegistro = registros.tipos[indice_registro]
                        instrucao.tipo_local = 7 + indice_registro
                        instrucao.tipo_unidade = indice_igual + 1
                        plano.quantidade_locais = plano.quantidade_locais + layout.quantidade_slots - 1
                    }
                }
            }
            se plano.quantidade_locais > 128 {
                plano.codigo_erro = 8
                retorne mova(plano)
            }
            indice_igual = indice_igual + 2
        }
        se declaracao e (instrucao.tipo_local == 5 ou instrucao.tipo_local >= 7) {
            // O tipo lista[inteiro] nasce vazio e nao recebe inicializador.
            // O indice ja aponta para a proxima instrucao, ou para ';'.
            seja apos_lista: lexico.UnidadeLexica = unidades[indice_igual]
            se fluxo.simbolo(fonte, apos_lista, 61) {
                plano.codigo_erro = 2
                retorne mova(plano)
            }
            instrucao.categoria = 1
            instrucao.unidade_nome = posicao_nome
            adicione(plano.instrucoes, instrucao)
            i = indice_igual
            se i < total {
                seja fim_lista: lexico.UnidadeLexica = unidades[i]
                se fluxo.simbolo(fonte, fim_lista, 59) {
                    i = i + 1
                }
            }
            continue
        }
        seja atribuicao: lexico.UnidadeLexica = unidades[indice_igual]
        se nao fluxo.simbolo(fonte, atribuicao, 61) ou indice_igual + 1 >= total {
            plano.codigo_erro = 3
            plano.unidade_erro = indice_igual
            retorne mova(plano)
        }
        instrucao.categoria = 2
        se declaracao {
            instrucao.categoria = 1
        }
        se indexado {
            instrucao.categoria = 11
        }
        se instrucao.campo_unidade >= 0 {
            instrucao.categoria = 14
            se indexado {
                instrucao.categoria = 15
            }
        }
        instrucao.unidade_nome = posicao_nome
        instrucao.valor_inicio = indice_igual + 1
        instrucao.valor_fim = fluxo.fim_expressao(fonte, unidades, instrucao.valor_inicio, nome.linha)
        se instrucao.valor_fim <= instrucao.valor_inicio {
            plano.codigo_erro = 4
            retorne mova(plano)
        }
        se instrucao.categoria == 1 e instrucao.tipo_local == 2 {
            seja inicializador: lexico.UnidadeLexica = unidades[instrucao.valor_inicio]
            se fluxo.igual(fonte, inicializador, empreste(texto_criar)) {
                instrucao.tipo_local = 3
            }
            // O buffer fixo precisa de dois slots para o descritor
            // de emprestimo: ponteiro dos dados e comprimento.
            // O buffer dinamico conserva o layout anterior de 5 slots.
            se instrucao.tipo_local == 2 {
                plano.quantidade_locais = plano.quantidade_locais + 2
                se plano.quantidade_locais > 128 {
                    plano.codigo_erro = 8
                    retorne mova(plano)
                }
            }
        }
        adicione(plano.instrucoes, instrucao)
        i = instrucao.valor_fim
        se i < total {
            seja separador: lexico.UnidadeLexica = unidades[i]
            se fluxo.simbolo(fonte, separador, 59) {
                i = i + 1
            }
        }
    }
    se i != total ou profundidade != 0 ou quantidade_lacos != 0 ou tamanho(pilha_controles) != 0 ou plano.quantidade_locais < 1 {
        plano.codigo_erro = 2
        retorne mova(plano)
    }
    se tamanho(plano.instrucoes) == 0 {
        plano.codigo_erro = 2
        retorne mova(plano)
    }
    seja ultima: Instrucao = plano.instrucoes[tamanho(plano.instrucoes) - 1]
    se ultima.categoria != 6 {
        plano.codigo_erro = 2
        retorne mova(plano)
    }
    plano.unidade_erro = total
    retorne mova(plano)
}

// Analise de caminhos da IR: uma condicao so garante retorno quando
// os dois ramos retornam. Um laco pode nao executar, portanto nunca
// garante retorno sozinho. Nao executa expressoes nem assume constantes.
privado tipo EscopoRetorno {
    classe: inteiro
    garantido_antes: logico
    garantido_primeiro: logico
}

privado tipo DiagnosticoRetorno {
    codigo: inteiro
    unidade: inteiro
}

privado funcao verificar_retorno(plano: emprestimo[Plano]) -> DiagnosticoRetorno {
    seja resposta: DiagnosticoRetorno
    seja pilha: lista[EscopoRetorno]
    seja garantido = falso
    seja indice = 0
    enquanto indice < tamanho(plano.instrucoes) {
        seja instrucao: Instrucao = plano.instrucoes[indice]
        resposta.unidade = instrucao.unidade_inicio

        // A transicao senao encerra apenas o primeiro ramo.
        se instrucao.categoria == 8 {
            se tamanho(pilha) == 0 {
                resposta.codigo = 7
                retorne resposta
            }
            seja escopo: EscopoRetorno = pilha[tamanho(pilha) - 1]
            se escopo.classe != 3 {
                resposta.codigo = 7
                retorne resposta
            }
            escopo.garantido_primeiro = garantido
            escopo.classe = 8
            pilha[tamanho(pilha) - 1] = escopo
            garantido = falso
            indice = indice + 1
            continue
        }

        // Apos o fechamento, a garantia retorna ao escopo externo.
        se instrucao.categoria == 5 {
            se tamanho(pilha) == 0 {
                resposta.codigo = 2
                retorne resposta
            }
            seja escopo: EscopoRetorno = pilha[tamanho(pilha) - 1]
            remova_ultimo(pilha)
            seja retorna_bloco = falso
            se escopo.classe == 8 {
                retorna_bloco = escopo.garantido_primeiro e garantido
            }
            // Se sem senao e enquanto nao garantem retorno.
            garantido = escopo.garantido_antes ou retorna_bloco
            indice = indice + 1
            continue
        }

        // O fechamento final e permitido mesmo apos retorno garantido.
        se instrucao.categoria == 6 {
            se tamanho(pilha) != 0 {
                resposta.codigo = 2
                retorne resposta
            }
            se nao garantido {
                resposta.codigo = 11
            }
            retorne resposta
        }

        // Uma instrucao apos um retorno garantido e inalcancavel,
        // incluindo o caso se/senao com retornos nos dois ramos.
        se garantido {
            resposta.codigo = 10
            retorne resposta
        }

        se instrucao.categoria == 3 ou instrucao.categoria == 4 {
            seja escopo: EscopoRetorno
            escopo.classe = instrucao.categoria
            escopo.garantido_antes = garantido
            adicione(pilha, escopo)
            garantido = falso
        }
        se instrucao.categoria == 7 {
            garantido = verdadeiro
        }
        indice = indice + 1
    }
    resposta.codigo = 2
    retorne resposta
}

// Analisar corpo de funcao no mesmo formato de IR do bloco principal.
// Categoria 7: retorne, categoria 8: transicao senao.
// Erro 10: instrucao inalcancavel por retorno garantido.
// Erro 11: existe caminho que termina sem retorne.
publico funcao analisar_corpo(fonte: emprestimo[bytes], unidades: emprestimo[lista[lexico.UnidadeLexica]], abertura_corpo: inteiro, fechamento_corpo: inteiro) -> Plano {
    seja plano: Plano
    seja registros = esquemas.analisar(fonte, unidades)
    se registros.codigo_erro != 0 {
        plano.codigo_erro = registros.codigo_erro
        plano.unidade_erro = registros.unidade_erro
        retorne mova(plano)
    }
    seja total = tamanho(unidades)
    se total > 12000 ou abertura_corpo < 0 ou fechamento_corpo >= total ou abertura_corpo + 1 >= fechamento_corpo {
        plano.codigo_erro = 8
        retorne mova(plano)
    }
    seja texto_seja: texto = "seja"
    seja texto_inteiro: texto = "inteiro"
    seja texto_bytes: texto = "bytes"
    seja texto_lista: texto = "lista"
    seja texto_adicione: texto = "adicione"
    seja texto_criar: texto = "criar_bytes"
    seja texto_liberar: texto = "liberar_bytes"
    seja texto_se: texto = "se"
    seja texto_enquanto: texto = "enquanto"
    seja texto_senao: texto = "senao"
    seja texto_pare: texto = "pare"
    seja texto_continue: texto = "continue"
    seja abertura: lexico.UnidadeLexica = unidades[abertura_corpo]
    seja fechamento: lexico.UnidadeLexica = unidades[fechamento_corpo]
    se nao fluxo.simbolo(fonte, abertura, 123) ou nao fluxo.simbolo(fonte, fechamento, 125) {
        plano.codigo_erro = 2
        retorne mova(plano)
    }
    seja texto_retorne: texto = "retorne"
    seja profundidade = 0
    seja pilha_controles: lista[inteiro]
    seja quantidade_lacos = 0
    seja i = abertura_corpo + 1
    seja retorno_bloqueante = -1
    enquanto i <= fechamento_corpo {
        plano.unidade_erro = i
        seja token: lexico.UnidadeLexica = unidades[i]
        seja instrucao: Instrucao
        instrucao.unidade_inicio = i
        instrucao.unidade_nome = -1
        instrucao.valor_inicio = -1
        instrucao.valor_fim = -1
        instrucao.indice_inicio = -1
        instrucao.indice_fim = -1
        instrucao.tipo_unidade = -1
        instrucao.campo_unidade = -1
        instrucao.campo_fim = -1
        instrucao.profundidade = profundidade
        // Apos retorne, apenas o fechamento do mesmo bloco e alcancavel.
        // Um retorno dentro de se/enquanto nao bloqueia comandos fora dele.
        se retorno_bloqueante >= 0 {
            se fluxo.simbolo(fonte, token, 125) e profundidade == retorno_bloqueante {
                retorno_bloqueante = -1
            } senao {
                plano.codigo_erro = 10
                plano.unidade_erro = i
                retorne mova(plano)
            }
        }
        se fluxo.simbolo(fonte, token, 125) {
            se profundidade == 0 {
                se i != fechamento_corpo {
                    plano.codigo_erro = 2
                    retorne mova(plano)
                }
                instrucao.categoria = 6
                adicione(plano.instrucoes, instrucao)
                i = i + 1
                pare
            }
            // "senao" reutiliza o nivel do "se": a transicao fecha
            // o bloco verdadeiro e abre o falso sem encerrar o controle.
            se i + 1 < total {
                seja palavra_senao: lexico.UnidadeLexica = unidades[i + 1]
                se fluxo.igual(fonte, palavra_senao, empreste(texto_senao)) {
                    plano.unidade_erro = i + 1
                    se tamanho(pilha_controles) == 0 ou pilha_controles[tamanho(pilha_controles) - 1] != 3 ou i + 2 >= total {
                        plano.codigo_erro = 7
                        retorne mova(plano)
                    }
                    seja abre_senao: lexico.UnidadeLexica = unidades[i + 2]
                    se nao fluxo.simbolo(fonte, abre_senao, 123) {
                        plano.codigo_erro = 7
                        retorne mova(plano)
                    }
                    instrucao.categoria = 8
                    adicione(plano.instrucoes, instrucao)
                    pilha_controles[tamanho(pilha_controles) - 1] = 8
                    i = i + 3
                    continue
                }
            }
            instrucao.categoria = 5
            adicione(plano.instrucoes, instrucao)
            se pilha_controles[tamanho(pilha_controles) - 1] == 4 {
                quantidade_lacos = quantidade_lacos - 1
            }
            remova_ultimo(pilha_controles)
            profundidade = profundidade - 1
            i = i + 1
            continue
        }
        seja eh_se = fluxo.igual(fonte, token, empreste(texto_se))
        seja eh_enquanto = fluxo.igual(fonte, token, empreste(texto_enquanto))
        se eh_se ou eh_enquanto {
            se profundidade >= 32 {
                plano.codigo_erro = 8
                retorne mova(plano)
            }
            seja cursor = i + 1
            seja nivel_parenteses = 0
            enquanto cursor < fechamento_corpo {
                seja atual: lexico.UnidadeLexica = unidades[cursor]
                se fluxo.simbolo(fonte, atual, 40) {
                    nivel_parenteses = nivel_parenteses + 1
                }
                se fluxo.simbolo(fonte, atual, 41) {
                    nivel_parenteses = nivel_parenteses - 1
                }
                se nivel_parenteses < 0 {
                    pare
                }
                se nivel_parenteses == 0 e fluxo.simbolo(fonte, atual, 123) {
                    pare
                }
                cursor = cursor + 1
            }
            se cursor >= fechamento_corpo ou cursor == i + 1 ou nivel_parenteses != 0 {
                plano.codigo_erro = 7
                retorne mova(plano)
            }
            seja inicio_bloco: lexico.UnidadeLexica = unidades[cursor]
            se nao fluxo.simbolo(fonte, inicio_bloco, 123) {
                plano.codigo_erro = 7
                retorne mova(plano)
            }
            instrucao.categoria = 3
            se eh_enquanto {
                instrucao.categoria = 4
            }
            instrucao.valor_inicio = i + 1
            instrucao.valor_fim = cursor
            adicione(plano.instrucoes, instrucao)
            adicione(pilha_controles, instrucao.categoria)
            se instrucao.categoria == 4 {
                quantidade_lacos = quantidade_lacos + 1
            }
            profundidade = profundidade + 1
            i = cursor + 1
            continue
        }
        se fluxo.igual(fonte, token, empreste(texto_retorne)) {
            instrucao.categoria = 7
            instrucao.valor_inicio = i + 1
            instrucao.valor_fim = fluxo.fim_expressao(fonte, unidades, instrucao.valor_inicio, token.linha)
            se instrucao.valor_fim <= instrucao.valor_inicio ou instrucao.valor_fim > fechamento_corpo {
                plano.codigo_erro = 4
                retorne mova(plano)
            }
            retorno_bloqueante = profundidade
            adicione(plano.instrucoes, instrucao)
            i = instrucao.valor_fim
            se i < fechamento_corpo {
                seja separador_retorno: lexico.UnidadeLexica = unidades[i]
                se fluxo.simbolo(fonte, separador_retorno, 59) {
                    i = i + 1
                }
            }
            continue
        }
        seja comando_pare = fluxo.igual(fonte, token, empreste(texto_pare))
        seja comando_continue = fluxo.igual(fonte, token, empreste(texto_continue))
        se comando_pare ou comando_continue {
            se quantidade_lacos == 0 {
                plano.codigo_erro = 16
                retorne mova(plano)
            }
            instrucao.categoria = 9
            se comando_continue {
                instrucao.categoria = 10
            }
            adicione(plano.instrucoes, instrucao)
            retorno_bloqueante = profundidade
            i = i + 1
            se i < fechamento_corpo {
                seja seguinte: lexico.UnidadeLexica = unidades[i]
                se fluxo.simbolo(fonte, seguinte, 59) {
                    i = i + 1
                } senao {
                    se seguinte.linha == token.linha e nao fluxo.simbolo(fonte, seguinte, 125) {
                        plano.codigo_erro = 16
                        plano.unidade_erro = i
                        retorne mova(plano)
                    }
                }
            }
            continue
        }
        se fluxo.simbolo(fonte, token, 123) {
            plano.codigo_erro = 3
            retorne mova(plano)
        }
        // adicione(lista, expressao): o tamanho e atualizado no emissor.
        se fluxo.igual(fonte, token, empreste(texto_adicione)) {
            se i + 5 >= total {
                plano.codigo_erro = 3
                retorne mova(plano)
            }
            seja abertura_adicionar: lexico.UnidadeLexica = unidades[i + 1]
            seja nome_adicionar: lexico.UnidadeLexica = unidades[i + 2]
            seja virgula_adicionar: lexico.UnidadeLexica = unidades[i + 3]
            se nao fluxo.simbolo(fonte, abertura_adicionar, 40) ou nome_adicionar.classe != 1 ou nao fluxo.simbolo(fonte, virgula_adicionar, 44) {
                plano.codigo_erro = 3
                retorne mova(plano)
            }
            seja cursor_adicionar = i + 4
            seja nivel_adicionar = 0
            enquanto cursor_adicionar < total {
                seja atual_adicionar: lexico.UnidadeLexica = unidades[cursor_adicionar]
                se fluxo.simbolo(fonte, atual_adicionar, 40) {
                    nivel_adicionar = nivel_adicionar + 1
                }
                se fluxo.simbolo(fonte, atual_adicionar, 41) {
                    se nivel_adicionar == 0 {
                        pare
                    }
                    nivel_adicionar = nivel_adicionar - 1
                }
                se fluxo.simbolo(fonte, atual_adicionar, 125) {
                    pare
                }
                cursor_adicionar = cursor_adicionar + 1
            }
            se cursor_adicionar >= total ou cursor_adicionar == i + 4 {
                plano.codigo_erro = 3
                retorne mova(plano)
            }
            seja fecho_adicionar: lexico.UnidadeLexica = unidades[cursor_adicionar]
            se nao fluxo.simbolo(fonte, fecho_adicionar, 41) {
                plano.codigo_erro = 3
                retorne mova(plano)
            }
            instrucao.categoria = 13
            instrucao.unidade_nome = i + 2
            instrucao.valor_inicio = i + 4
            instrucao.valor_fim = cursor_adicionar
            adicione(plano.instrucoes, instrucao)
            i = cursor_adicionar + 1
            se i < total {
                seja separador_adicionar: lexico.UnidadeLexica = unidades[i]
                se fluxo.simbolo(fonte, separador_adicionar, 59) {
                    i = i + 1
                }
            }
            continue
        }
        // liberar_bytes(nome) e uma instrucao explicita de ciclo de vida.
        se fluxo.igual(fonte, token, empreste(texto_liberar)) {
            se i + 3 >= total {
                plano.codigo_erro = 3
                retorne mova(plano)
            }
            seja abre_liberar: lexico.UnidadeLexica = unidades[i + 1]
            seja nome_liberar: lexico.UnidadeLexica = unidades[i + 2]
            seja fecha_liberar: lexico.UnidadeLexica = unidades[i + 3]
            se nao fluxo.simbolo(fonte, abre_liberar, 40) ou nome_liberar.classe != 1 ou nao fluxo.simbolo(fonte, fecha_liberar, 41) {
                plano.codigo_erro = 3
                retorne mova(plano)
            }
            instrucao.categoria = 12
            instrucao.unidade_nome = i + 2
            adicione(plano.instrucoes, instrucao)
            i = i + 4
            se i < total {
                seja separador_liberar: lexico.UnidadeLexica = unidades[i]
                se fluxo.simbolo(fonte, separador_liberar, 59) {
                    i = i + 1
                }
            }
            continue
        }
        seja declaracao = fluxo.igual(fonte, token, empreste(texto_seja))
        seja posicao_nome = i
        se declaracao {
            // Declaracoes em se, senao e enquanto tambem recebem um slot
            // proprio; a visibilidade e controlada pelo emissor.
            posicao_nome = i + 1
            plano.quantidade_locais = plano.quantidade_locais + 1
            se plano.quantidade_locais > 128 {
                plano.codigo_erro = 8
                retorne mova(plano)
            }
        }
        se posicao_nome + 2 >= total {
            plano.codigo_erro = 3
            retorne mova(plano)
        }
        seja nome: lexico.UnidadeLexica = unidades[posicao_nome]
        se nome.classe != 1 {
            plano.codigo_erro = 3
            retorne mova(plano)
        }
        seja indice_igual = posicao_nome + 1
        // Uma atribuicao indexada e uma instrucao diferente da atribuicao
        // do buffer inteiro: dados[indice] = valor.
        seja indexado = falso
        se nao declaracao {
            // registro.campo = expressao, sem indexacao nem copia.
            seja abertura_campo: lexico.UnidadeLexica = unidades[indice_igual]
            se fluxo.simbolo(fonte, abertura_campo, 46) {
                se indice_igual + 2 >= total {
                    plano.codigo_erro = 3
                    retorne mova(plano)
                }
                seja nome_campo: lexico.UnidadeLexica = unidades[indice_igual + 1]
                se nome_campo.classe != 1 {
                    plano.codigo_erro = 3
                    retorne mova(plano)
                }
                instrucao.campo_unidade = indice_igual + 1
                indice_igual = indice_igual + 2
                enquanto indice_igual + 1 < total {
                    seja ponto_extra: lexico.UnidadeLexica = unidades[indice_igual]
                    se nao fluxo.simbolo(fonte, ponto_extra, 46) {
                        pare
                    }
                    seja parte_extra: lexico.UnidadeLexica = unidades[indice_igual + 1]
                    se parte_extra.classe != 1 {
                        plano.codigo_erro = 3
                        retorne mova(plano)
                    }
                    indice_igual = indice_igual + 2
                }
                instrucao.campo_fim = indice_igual
            }
            seja abertura_indice: lexico.UnidadeLexica = unidades[indice_igual]
            se fluxo.simbolo(fonte, abertura_indice, 91) {
                instrucao.indice_inicio = indice_igual + 1
                seja cursor_indice = instrucao.indice_inicio
                enquanto cursor_indice < total {
                    seja atual_indice: lexico.UnidadeLexica = unidades[cursor_indice]
                    se fluxo.simbolo(fonte, atual_indice, 93) {
                        pare
                    }
                    cursor_indice = cursor_indice + 1
                }
                se cursor_indice >= total ou cursor_indice == instrucao.indice_inicio {
                    plano.codigo_erro = 3
                    retorne mova(plano)
                }
                instrucao.indice_fim = cursor_indice
                indice_igual = cursor_indice + 1
                indexado = verdadeiro
                se indice_igual >= total {
                    plano.codigo_erro = 3
                    retorne mova(plano)
                }
                // lista_registros[indice].campo = expressao.
                seja talvez_ponto: lexico.UnidadeLexica = unidades[indice_igual]
                se fluxo.simbolo(fonte, talvez_ponto, 46) {
                    se indice_igual + 2 >= total {
                        plano.codigo_erro = 3
                        retorne mova(plano)
                    }
                    seja campo_indexado: lexico.UnidadeLexica = unidades[indice_igual + 1]
                    se campo_indexado.classe != 1 {
                        plano.codigo_erro = 3
                        retorne mova(plano)
                    }
                    instrucao.campo_unidade = indice_igual + 1
                    indice_igual = indice_igual + 2
                    enquanto indice_igual + 1 < total {
                        seja ponto_extra: lexico.UnidadeLexica = unidades[indice_igual]
                        se nao fluxo.simbolo(fonte, ponto_extra, 46) {
                            pare
                        }
                        seja parte_extra: lexico.UnidadeLexica = unidades[indice_igual + 1]
                        se parte_extra.classe != 1 {
                            plano.codigo_erro = 3
                            retorne mova(plano)
                        }
                        indice_igual = indice_igual + 2
                    }
                    instrucao.campo_fim = indice_igual
                }
            }
        }
        // Bytes locais usam 7 slots: comprimento, 32 bytes de dados e
        // 2 slots de descritor emprestavel. Dinamicos mantem 5 slots.
        // Outras declaracoes continuam usando apenas um slot.
        instrucao.tipo_local = 1
        seja separador_tipo: lexico.UnidadeLexica = unidades[indice_igual]
        se declaracao e fluxo.simbolo(fonte, separador_tipo, 58) {
            se indice_igual + 2 >= total {
                plano.codigo_erro = 3
                retorne mova(plano)
            }
            seja unidade_tipo: lexico.UnidadeLexica = unidades[indice_igual + 1]
            plano.unidade_erro = indice_igual + 1
            se fluxo.igual(fonte, unidade_tipo, empreste(texto_bytes)) {
                instrucao.tipo_local = 2
                plano.quantidade_locais = plano.quantidade_locais + 4
            } senao {
                se fluxo.igual(fonte, unidade_tipo, empreste(texto_lista)) {
                    // lista[inteiro]: qword de tamanho e oito inteiros.
                    se indice_igual + 5 >= total {
                        plano.codigo_erro = 2
                        retorne mova(plano)
                    }
                    seja abre_lista: lexico.UnidadeLexica = unidades[indice_igual + 2]
                    seja item_lista: lexico.UnidadeLexica = unidades[indice_igual + 3]
                    seja fecha_lista: lexico.UnidadeLexica = unidades[indice_igual + 4]
                    se nao fluxo.simbolo(fonte, abre_lista, 91) ou nao fluxo.simbolo(fonte, fecha_lista, 93) {
                        plano.codigo_erro = 2
                        retorne mova(plano)
                    }
                    se fluxo.igual(fonte, item_lista, empreste(texto_inteiro)) {
                        instrucao.tipo_local = 5
                    } senao {
                        seja tipo_elemento = esquemas.buscar_tipo(fonte, unidades, empreste(registros), item_lista)
                        se tipo_elemento < 0 {
                            plano.codigo_erro = 2
                            retorne mova(plano)
                        }
                        instrucao.tipo_local = 20 + tipo_elemento
                    }
                    plano.quantidade_locais = plano.quantidade_locais + 2
                    indice_igual = indice_igual + 3
                } senao {
                    se nao fluxo.igual(fonte, unidade_tipo, empreste(texto_inteiro)) {
                        seja indice_registro = esquemas.buscar_tipo(fonte, unidades, empreste(registros), unidade_tipo)
                        se indice_registro < 0 {
                            plano.codigo_erro = 2
                            retorne mova(plano)
                        }
                        seja layout: esquemas.TipoRegistro = registros.tipos[indice_registro]
                        instrucao.tipo_local = 7 + indice_registro
                        instrucao.tipo_unidade = indice_igual + 1
                        plano.quantidade_locais = plano.quantidade_locais + layout.quantidade_slots - 1
                    }
                }
            }
            se plano.quantidade_locais > 128 {
                plano.codigo_erro = 8
                retorne mova(plano)
            }
            indice_igual = indice_igual + 2
        }
        se declaracao e (instrucao.tipo_local == 5 ou instrucao.tipo_local >= 7) {
            // O tipo lista[inteiro] nasce vazio e nao recebe inicializador.
            // O indice ja aponta para a proxima instrucao, ou para ';'.
            seja apos_lista: lexico.UnidadeLexica = unidades[indice_igual]
            se fluxo.simbolo(fonte, apos_lista, 61) {
                plano.codigo_erro = 2
                retorne mova(plano)
            }
            instrucao.categoria = 1
            instrucao.unidade_nome = posicao_nome
            adicione(plano.instrucoes, instrucao)
            i = indice_igual
            se i < total {
                seja fim_lista: lexico.UnidadeLexica = unidades[i]
                se fluxo.simbolo(fonte, fim_lista, 59) {
                    i = i + 1
                }
            }
            continue
        }
        seja atribuicao: lexico.UnidadeLexica = unidades[indice_igual]
        se nao fluxo.simbolo(fonte, atribuicao, 61) ou indice_igual + 1 >= total {
            plano.codigo_erro = 3
            plano.unidade_erro = indice_igual
            retorne mova(plano)
        }
        instrucao.categoria = 2
        se declaracao {
            instrucao.categoria = 1
        }
        se indexado {
            instrucao.categoria = 11
        }
        se instrucao.campo_unidade >= 0 {
            instrucao.categoria = 14
            se indexado {
                instrucao.categoria = 15
            }
        }
        instrucao.unidade_nome = posicao_nome
        instrucao.valor_inicio = indice_igual + 1
        instrucao.valor_fim = fluxo.fim_expressao(fonte, unidades, instrucao.valor_inicio, nome.linha)
        se instrucao.valor_fim <= instrucao.valor_inicio {
            plano.codigo_erro = 4
            retorne mova(plano)
        }
        se instrucao.categoria == 1 e instrucao.tipo_local == 2 {
            seja inicializador: lexico.UnidadeLexica = unidades[instrucao.valor_inicio]
            se fluxo.igual(fonte, inicializador, empreste(texto_criar)) {
                instrucao.tipo_local = 3
            }
            // O buffer fixo precisa de dois slots para o descritor
            // de emprestimo: ponteiro dos dados e comprimento.
            // O buffer dinamico conserva o layout anterior de 5 slots.
            se instrucao.tipo_local == 2 {
                plano.quantidade_locais = plano.quantidade_locais + 2
                se plano.quantidade_locais > 128 {
                    plano.codigo_erro = 8
                    retorne mova(plano)
                }
            }
        }
        adicione(plano.instrucoes, instrucao)
        i = instrucao.valor_fim
        se i < total {
            seja separador: lexico.UnidadeLexica = unidades[i]
            se fluxo.simbolo(fonte, separador, 59) {
                i = i + 1
            }
        }
    }
    se i != fechamento_corpo + 1 ou profundidade != 0 ou quantidade_lacos != 0 ou tamanho(pilha_controles) != 0 {
        plano.codigo_erro = 2
        retorne mova(plano)
    }
    se tamanho(plano.instrucoes) < 2 {
        plano.codigo_erro = 2
        retorne mova(plano)
    }
    seja ultima: Instrucao = plano.instrucoes[tamanho(plano.instrucoes) - 1]
    se ultima.categoria != 6 {
        plano.codigo_erro = 2
        retorne mova(plano)
    }
    seja caminhos = verificar_retorno(empreste(plano))
    se caminhos.codigo != 0 {
        plano.codigo_erro = caminhos.codigo
        plano.unidade_erro = caminhos.unidade
        retorne mova(plano)
    }
    plano.unidade_erro = fechamento_corpo
    retorne mova(plano)
}
