// Emissao x86-64 para registros locais de ate 8 campos inteiro.
// Cada campo tem 8 bytes; variavel aponta ao primeiro slot do registro.
// A verificacao dos nomes e feita pelo modulo de esquemas.
importe "emissao_elf_minima.rts" como elf
importe "emissao_fluxo_elf.rts" como fluxo

// O campo de numero zero usa o slot do nome do registro;
// os seguintes ocupam slots ocultos subsequentes.
publico funcao inicializar(codigo: bytes, indice_local: inteiro, quantidade: inteiro) -> bytes {
    seja indice = 0
    enquanto indice < quantidade {
        adicione_byte(codigo, 72)
        adicione_byte(codigo, 199)
        adicione_byte(codigo, 133) // mov qword [rbp-disp32], 0
        seja endereco = fluxo.endereco(mova(codigo), indice_local + indice)
        mova(codigo, endereco)
        seja zero = elf.anexar_inteiro(mova(codigo), 0, 4)
        mova(codigo, zero)
        indice = indice + 1
    }
    retorne mova(codigo)
}

// Carrega o valor de um campo inteiro e o empilha na ABI do emissor.
publico funcao emitir_leitura(codigo: bytes, indice_local: inteiro, campo: inteiro) -> bytes {
    adicione_byte(codigo, 72)
    adicione_byte(codigo, 139)
    adicione_byte(codigo, 133) // mov rax, [rbp-disp32]
    seja endereco = fluxo.endereco(mova(codigo), indice_local + campo)
    mova(codigo, endereco)
    adicione_byte(codigo, 80) // push rax
    retorne mova(codigo)
}

// Consome o valor inteiro no topo da pilha, sem alterar outros campos.
publico funcao emitir_escrita(codigo: bytes, indice_local: inteiro, campo: inteiro) -> bytes {
    adicione_byte(codigo, 88) // pop rax
    adicione_byte(codigo, 72)
    adicione_byte(codigo, 137)
    adicione_byte(codigo, 133) // mov [rbp-disp32], rax
    seja endereco = fluxo.endereco(mova(codigo), indice_local + campo)
    mova(codigo, endereco)
    retorne mova(codigo)
}

// Leitura readonly por referencia a um registro local (incluindo campos
// achatados de sub-registros). O endereco referencia o primeiro slot
// do registro dono no quadro da funcao chamadora.
publico funcao emitir_leitura_emprestada(codigo: bytes, indice_local: inteiro, campo: inteiro) -> bytes {
    adicione_byte(codigo, 72)
    adicione_byte(codigo, 139)
    adicione_byte(codigo, 149) // mov rdx, [rbp - referencia]
    seja referencia = fluxo.endereco(mova(codigo), indice_local)
    mova(codigo, referencia)
    adicione_byte(codigo, 72)
    adicione_byte(codigo, 139)
    adicione_byte(codigo, 130) // mov rax, [rdx + disp32]
    seja endereco_campo = elf.anexar_inteiro(mova(codigo), 4294967296 - campo * 8, 4)
    mova(codigo, endereco_campo)
    adicione_byte(codigo, 80)
    retorne mova(codigo)
}

// Copia um registro do endereco do argumento para slots exclusivos do callee.
// Substitui o valor do parametro pelo endereco da nova copia local.
publico funcao copiar_parametro(codigo: bytes, indice_parametro: inteiro, primeiro_slot: inteiro, quantidade: inteiro) -> bytes {
    adicione_byte(codigo, 72)
    adicione_byte(codigo, 139)
    adicione_byte(codigo, 149) // mov rdx, [rbp - parametro]
    seja origem = fluxo.endereco(mova(codigo), indice_parametro)
    mova(codigo, origem)
    seja i = 0
    enquanto i < quantidade {
        adicione_byte(codigo, 72)
        adicione_byte(codigo, 139)
        adicione_byte(codigo, 130) // mov rax, [rdx - i*8]
        seja deslocamento_origem = elf.anexar_inteiro(mova(codigo), 4294967296 - i * 8, 4)
        mova(codigo, deslocamento_origem)
        adicione_byte(codigo, 72)
        adicione_byte(codigo, 137)
        adicione_byte(codigo, 133) // mov [rbp - destino], rax
        seja destino = fluxo.endereco(mova(codigo), primeiro_slot + i)
        mova(codigo, destino)
        i = i + 1
    }
    adicione_byte(codigo, 72)
    adicione_byte(codigo, 141)
    adicione_byte(codigo, 133) // lea rax, [rbp - primeiro_slot]
    seja endereco_local = fluxo.endereco(mova(codigo), primeiro_slot)
    mova(codigo, endereco_local)
    adicione_byte(codigo, 72)
    adicione_byte(codigo, 137)
    adicione_byte(codigo, 133) // mov [rbp - parametro], rax
    seja endereco_parametro = fluxo.endereco(mova(codigo), indice_parametro)
    mova(codigo, endereco_parametro)
    retorne mova(codigo)
}

// Escreve somente na copia local de um parametro por valor.
publico funcao emitir_escrita_referenciada(codigo: bytes, indice_parametro: inteiro, campo: inteiro) -> bytes {
    adicione_byte(codigo, 88) // pop rax
    adicione_byte(codigo, 72)
    adicione_byte(codigo, 139)
    adicione_byte(codigo, 149) // mov rdx, [rbp - parametro]
    seja referencia = fluxo.endereco(mova(codigo), indice_parametro)
    mova(codigo, referencia)
    adicione_byte(codigo, 72)
    adicione_byte(codigo, 137)
    adicione_byte(codigo, 130) // mov [rdx - campo*8], rax
    seja endereco_campo = elf.anexar_inteiro(mova(codigo), 4294967296 - campo * 8, 4)
    mova(codigo, endereco_campo)
    retorne mova(codigo)
}

// Copia o registro devolvido para o buffer do chamador.
// ABI experimental de retorno: ponteiro oculto em [rbp + 16].
// O destino e obrigatoriamente um buffer proprio e com "quantidade"
// slots de oito bytes, reservado pelo chamador. O emissor chamador
// ainda sera integrado; esta rotina apenas implementa a transferencia.
// Para origem_referenciada, o slot de origem contem um ponteiro para
// o primeiro campo do registro. Caso contrario, os campos estao
// diretamente nos slots consecutivos do quadro atual.
// O resultado em rax e o endereco do buffer de retorno.
publico funcao copiar_para_retorno(codigo: bytes, origem_local: inteiro, quantidade: inteiro, origem_referenciada: logico) -> bytes {
    // mov rdx, [rbp + 16] (ponteiro oculto de retorno)
    adicione_byte(codigo, 72)
    adicione_byte(codigo, 139)
    adicione_byte(codigo, 149)
    seja ponteiro_retorno = elf.anexar_inteiro(mova(codigo), 16, 4)
    mova(codigo, ponteiro_retorno)
    se origem_referenciada {
        // mov rcx, [rbp - origem_local] (endereco dos campos)
        adicione_byte(codigo, 72)
        adicione_byte(codigo, 139)
        adicione_byte(codigo, 141)
        seja ponteiro_origem = fluxo.endereco(mova(codigo), origem_local)
        mova(codigo, ponteiro_origem)
    }
    seja indice = 0
    enquanto indice < quantidade {
        adicione_byte(codigo, 72)
        adicione_byte(codigo, 139)
        se origem_referenciada {
            adicione_byte(codigo, 129) // mov rax, [rcx - indice*8]
            seja deslocamento_origem = elf.anexar_inteiro(mova(codigo), 4294967296 - indice * 8, 4)
            mova(codigo, deslocamento_origem)
        } senao {
            adicione_byte(codigo, 133) // mov rax, [rbp - slot]
            seja origem = fluxo.endereco(mova(codigo), origem_local + indice)
            mova(codigo, origem)
        }
        adicione_byte(codigo, 72)
        adicione_byte(codigo, 137)
        adicione_byte(codigo, 130) // mov [rdx - indice*8], rax
        seja deslocamento_destino = elf.anexar_inteiro(mova(codigo), 4294967296 - indice * 8, 4)
        mova(codigo, deslocamento_destino)
        indice = indice + 1
    }
    adicione_byte(codigo, 72)
    adicione_byte(codigo, 137)
    adicione_byte(codigo, 208) // mov rax, rdx
    retorne mova(codigo)
}
